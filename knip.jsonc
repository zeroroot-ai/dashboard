{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,js,ts}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/gen/**",
    "src/generated/**",
    "src/data/**",
    "out/**",
    ".next/**",
    "scripts/ast-checks/fixtures/**",
    "components/ui/**"
  ],
  "ignoreDependencies": [
    "pg",
    "@vitest/coverage-v8",
    "@auth/core",
    "tailwindcss",
    "tailwindcss-animate",
    "eslint-config-next",
    "pino-pretty",
    "@bufbuild/buf",
    "@bufbuild/protoc-gen-es",
    "@zeroroot-ai/brand"
  ],
  "ignoreUnresolved": [],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "exports": "error",
    // types is warn, not error, and that is temporary. The knip 5 -> 6 bump
    // (#119) brought a stricter unused-export detector that found 50
    // exported types nothing imports, across 23 files. None of them is new
    // code; knip 5 could not see them. The full list and the plan are in
    // #161, and putting this back to "error" is that issue's close
    // condition. Every other rule stays at error, so files, exports,
    // binaries, dependencies and unlisted are all enforced more strictly
    // than they were before the bump. Baselined 2026-10-01.
    "types": "warn",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "classMembers": "error",
    "duplicates": "off",
    "optionalPeerDependencies": "off"
  },
  "next": {
    "entry": [
      "next.config.ts",
      "app/**/{page,layout,loading,error,not-found,template,default,route,global-error,sitemap,robots,manifest,opengraph-image,twitter-image,icon,apple-icon}.{ts,tsx}",
      "middleware.ts",
      "instrumentation.ts"
    ]
  },
  "vitest": {
    "config": [
      "vitest.config.ts"
    ],
    "entry": [
      "**/*.{test,spec}.{ts,tsx}",
      "**/__tests__/**/*.{ts,tsx}",
      "src/test/**/*.ts"
    ]
  },
  "playwright": {
    "config": [
      "playwright.config.ts"
    ],
    "entry": [
      "e2e/**/*.{test,spec}.{ts,tsx}",
      "e2e/**/*.setup.ts"
    ]
  },
  "ignoreBinaries": [
    "kubectl",
    "dnsx",
    "go",
    "openssl"
  ]
}
